#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
        zephyr,code-partition = &code_partition;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "col2row"; 

        row-gpios
            = <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // ROW0
            , <&gpio0 3  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // ROW1
            , <&gpio1 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // ROW2 (Now rewired to P1.13)
            , <&gpio0 28 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // ROW3
            , <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // ROW4
            , <&gpio0 30 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // ROW5
            ;

        col-gpios
            = <&gpio0 26 GPIO_ACTIVE_HIGH> // COL0
            , <&gpio0 6  GPIO_ACTIVE_HIGH> // COL1
            , <&gpio0 8  GPIO_ACTIVE_HIGH> // COL2
            , <&gpio0 27 GPIO_ACTIVE_HIGH> // COL3
            , <&gpio1 8  GPIO_ACTIVE_HIGH> // COL4
            , <&gpio0 11 GPIO_ACTIVE_HIGH> // COL5
            , <&gpio0 25 GPIO_ACTIVE_HIGH> // COL6
            , <&gpio1 12 GPIO_ACTIVE_HIGH> // COL7
            , <&gpio1 14 GPIO_ACTIVE_HIGH> // COL8
            , <&gpio0 24 GPIO_ACTIVE_HIGH> // COL9
            , <&gpio0 20 GPIO_ACTIVE_HIGH> // COL10
            , <&gpio0 17 GPIO_ACTIVE_HIGH> // COL11
            , <&gpio0 15 GPIO_ACTIVE_HIGH> // COL12
            , <&gpio0 14 GPIO_ACTIVE_HIGH> // COL13
            , <&gpio0 13 GPIO_ACTIVE_HIGH> // COL14
            , <&gpio0 16 GPIO_ACTIVE_HIGH> // COL15
            ;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <16>;
        rows = <6>;

        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,15)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13) RC(1,15)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13) RC(2,15)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11) RC(3,12) RC(3,13) RC(3,15)
            RC(4,0)         RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6) RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11)          RC(4,13) RC(4,14)
            RC(5,0) RC(5,1) RC(5,2)                         RC(5,6)                         RC(5,10) RC(5,11) RC(5,12) RC(5,13) RC(5,14) RC(5,15)
        >;
    };
};

/* Overwrite the default board partitions to start at 0x0 */
&flash0 {
    /delete-node/ partitions;
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;
        code_partition: partition@0 {
            reg = <0x00000000 0x000f0000>;
        };
        storage_partition: partition@f0000 {
            reg = <0x000f0000 0x00010000>;
        };
    };
};